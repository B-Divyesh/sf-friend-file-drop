{
  "name": "friend-file-drop",
  "version": "1.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "npm ci --prefix api --omit=dev",
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:unit": "node --test api/lib/store.test.js api/integration.test.js tests/deployment-identity.test.js tests/release-config.test.js",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:unit && npm run build && playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.13.4",
    "typescript": "5.7.3",
    "vite": "6.4.3"
  }
}
